# FICTIONAL. Copy to secrets-stg.properties (or secrets-prd.properties) next to
# environments.properties. chmod 600. Never commit the copy. Never paste values
# into chat.
#
# Keys the deployer looks up (names only appear in the plan):
#   <driver>.shim-auth-password
#   <driver>.remote-loader-password
#   <driver>.named.<password-name>
#   driverset.named.<password-name>
# Each key accepts the same four forms as the bind password:
#   key=  keyEnv=  keyCommand=  keyKeychain=service[/account]

AD Driver.shim-auth-passwordEnv=ACME_AD_SHIM_PASSWORD
AD Driver.remote-loader-passwordEnv=ACME_AD_RL_PASSWORD
AD Driver.named.exchange-serviceEnv=ACME_EXCHANGE_PASSWORD
driverset.named.smtp-relayEnv=ACME_SMTP_PASSWORD
