# build
target/
*.class

# proprietary NetIQ/OpenText jars — never commit (lib/ may be a symlink)
lib/*.jar
lib

# client artifacts & operational data — never commit
*.ldif
*.trace
*.log
TraceLog*.txt
artifacts/
exports/
trace samples/

# credentials / local-only cases
cases/**/case.properties
*.local.properties

# IDE / OS
.idea/
*.iml
.DS_Store

# vault targets and secrets — never committed
environments.properties
secrets*.properties
deploy-snapshots/

# Local audit log when this checkout is used as a working tree. Client repositories
# commit their own deploy-log; this repository must not.
deploy-log/

# python bytecode from bin/apps
__pycache__/

# VS Code / Cursor extension
extensions/*/node_modules/
extensions/*/out/
extensions/*/*.vsix
**/.dirxmldev/

# MCP server (sdk is installed locally; lockfile is committed)
mcp/**/node_modules/
