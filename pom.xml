<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.pointblue.dirxml</groupId>
    <artifactId>dirxml-dev</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>DirXML Dev</name>
    <description>Agent-driven IDM (DirXML) development: a typed model of a driver set,
        IDM-as-code on disk, validation, and vault deploy/operate with safeguards —
        built on the DirXML Policy Simulator as its test engine.</description>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <simulator.version>1.5.2</simulator.version>
        <!-- The idm.portable profile sets this so a clean runner can test doctor and the
             write gate without the proprietary jars. A normal `mvn test` still requires them. -->
        <idm.skip.engine>false</idm.skip.engine>
        <!-- systemPath must not name ${project.basedir} directly: Maven warns, and the
             warning prints the uninterpolated expression. This property is that directory. -->
        <idm.lib>${project.basedir}/lib</idm.lib>
    </properties>

    <dependencies>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>dirxml-dev-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
            <!-- requireFilesExist compares a path to its canonical path and reports a jar
                 reached through a symlink as missing (a directory symlink of lib/, or a
                 per-jar symlink). File.isFile follows links, which is the layout in
                 docs/install.md. bin/require-engine.sh checks the same names. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>require-engine</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <skip>${idm.skip.engine}</skip>
                            <target>
                                <available file="${idm.lib}/dirxml.jar" type="file" property="idm.ok.dirxml"/>
                                <available file="${idm.lib}/dirxml_misc.jar" type="file" property="idm.ok.dirxml_misc"/>
                                <available file="${idm.lib}/nxsl.jar" type="file" property="idm.ok.nxsl"/>
                                <available file="${idm.lib}/xp.jar" type="file" property="idm.ok.xp"/>
                                <available file="${idm.lib}/CommonDriverShim.jar" type="file" property="idm.ok.CommonDriverShim"/>
                                <available file="${idm.lib}/jclient.jar" type="file" property="idm.ok.jclient"/>
                                <available file="${idm.lib}/dhutil.jar" type="file" property="idm.ok.dhutil"/>
                                <available file="${idm.lib}/XDS.jar" type="file" property="idm.ok.XDS"/>
                                <available file="${idm.lib}/js.jar" type="file" property="idm.ok.js"/>
                                <available file="${idm.lib}/ldap.jar" type="file" property="idm.ok.ldap"/>
                                <available file="${user.home}/.m2/repository/com/pointblue/dirxml/dirxml-simulator/${simulator.version}/dirxml-simulator-${simulator.version}.jar" type="file" property="idm.ok.simulator"/>
                                <condition property="idm.engine.present">
                                    <and>
                                        <isset property="idm.ok.dirxml"/>
                                        <isset property="idm.ok.dirxml_misc"/>
                                        <isset property="idm.ok.nxsl"/>
                                        <isset property="idm.ok.xp"/>
                                        <isset property="idm.ok.CommonDriverShim"/>
                                        <isset property="idm.ok.jclient"/>
                                        <isset property="idm.ok.dhutil"/>
                                        <isset property="idm.ok.XDS"/>
                                        <isset property="idm.ok.js"/>
                                        <isset property="idm.ok.ldap"/>
                                        <isset property="idm.ok.simulator"/>
                                    </and>
                                </condition>
                                <fail unless="idm.engine.present" message="DirXMLDev needs the proprietary NetIQ/OpenText jars in lib/ and dirxml-simulator ${simulator.version} installed by 'mvn install' in the DirXMLSimulator repo. They are not committed and not on Maven Central. mvn test is the full suite and stops here when they are absent. bin/require-engine.sh names each missing path. Doctor and the write gate still run without them: mvn -B -Pidm.portable test. See docs/install.md section 2."/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Active when lib/dirxml.jar is present. File.exists follows a directory symlink
         and a per-jar symlink, so `ln -s ../DirXMLSimulator/lib lib` activates this profile.
         Maven resolves project dependencies before the lifecycle, so these stay out of the main
         POM: without them, `mvn test` reaches the validate check and stops with the file list.
         With them, the suite compiles. The profile does not make the jars optional —
         the sources import the engine and the simulator. -->
    <profiles>
        <profile>
            <id>engine</id>
            <activation>
                <file>
                    <exists>lib/dirxml.jar</exists>
                </file>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>com.pointblue.dirxml</groupId>
                    <artifactId>dirxml-simulator</artifactId>
                    <version>${simulator.version}</version>
                </dependency>
                <!-- Proprietary NetIQ/OpenText jars. System scope does not propagate, so they are
                     declared here as well as living in lib/. lib/ is gitignored. -->
                <dependency><groupId>com.netiq.idm</groupId><artifactId>dirxml</artifactId><version>4.10.1.0000</version><scope>system</scope><systemPath>${idm.lib}/dirxml.jar</systemPath></dependency>
                <dependency><groupId>com.netiq.idm</groupId><artifactId>dirxml_misc</artifactId><version>4.10.1.0000</version><scope>system</scope><systemPath>${idm.lib}/dirxml_misc.jar</systemPath></dependency>
                <dependency><groupId>com.netiq.idm</groupId><artifactId>nxsl</artifactId><version>1.0.0</version><scope>system</scope><systemPath>${idm.lib}/nxsl.jar</systemPath></dependency>
                <dependency><groupId>com.netiq.idm</groupId><artifactId>xp</artifactId><version>1.0.0</version><scope>system</scope><systemPath>${idm.lib}/xp.jar</systemPath></dependency>
                <dependency><groupId>com.netiq.idm</groupId><artifactId>CommonDriverShim</artifactId><version>1.0.0</version><scope>system</scope><systemPath>${idm.lib}/CommonDriverShim.jar</systemPath></dependency>
                <dependency><groupId>com.netiq.idm</groupId><artifactId>jclient</artifactId><version>1.0.0</version><scope>system</scope><systemPath>${idm.lib}/jclient.jar</systemPath></dependency>
                <dependency><groupId>com.netiq.idm</groupId><artifactId>dhutil</artifactId><version>1.0.0</version><scope>system</scope><systemPath>${idm.lib}/dhutil.jar</systemPath></dependency>
                <dependency><groupId>com.netiq.idm</groupId><artifactId>XDS</artifactId><version>1.0.0</version><scope>system</scope><systemPath>${idm.lib}/XDS.jar</systemPath></dependency>
                <dependency><groupId>com.netiq.idm</groupId><artifactId>js</artifactId><version>1.0.0</version><scope>system</scope><systemPath>${idm.lib}/js.jar</systemPath></dependency>
                <dependency><groupId>com.novell.ldap</groupId><artifactId>jldap</artifactId><version>4.3</version><scope>system</scope><systemPath>${idm.lib}/ldap.jar</systemPath></dependency>
            </dependencies>
        </profile>
        <!-- Tests that compile without the engine or the simulator. GitHub Actions runs this
             on every push. It does not compile the rest of src/main. `mvn test` (no profile)
             remains the full suite and still fails the validate check when the jars are absent. -->
        <profile>
            <id>idm.portable</id>
            <properties>
                <idm.skip.engine>true</idm.skip.engine>
                <maven.main.skip>true</maven.main.skip>
                <maven.test.skip>true</maven.test.skip>
                <maven.resources.skip>true</maven.resources.skip>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>3.3.1</version>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.8.1</version>
                        <executions>
                            <execution>
                                <id>portable-junit</id>
                                <phase>generate-test-resources</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <includeScope>test</includeScope>
                                    <outputDirectory>${project.build.directory}/portable-lib</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>portable-tests</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>${project.basedir}/bin/ci-portable.sh</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
