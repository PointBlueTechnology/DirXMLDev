<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.pointblue.dirxml</groupId>
    <artifactId>dirxml-dev</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>DirXML Dev</name>
    <description>Agent-driven IDM (DirXML) development: a typed model of a driver set,
        IDM-as-code on disk, validation, and vault deploy/operate with safeguards —
        built on the DirXML Policy Simulator as its test engine.</description>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <simulator.version>1.6.0</simulator.version>
        <!-- The idm.portable profile sets this so a clean runner can test doctor and the
             write gate without the proprietary jars. A normal `mvn test` still requires them. -->
        <idm.skip.engine>false</idm.skip.engine>
        <!-- systemPath must not name ${project.basedir} directly: Maven warns, and the
             warning prints the uninterpolated expression. This property is that directory. -->
        <idm.lib>${project.basedir}/lib</idm.lib>
    </properties>

    <dependencies>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>dirxml-dev-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
            <!-- requireFilesExist compares a path with its canonical path and reports the
                 file missing when they differ. A directory symlink of lib/, or a symlink of
                 a jar, fails that check even though ls sees the file. Real copies pass.
                 bin/require-engine.sh rejects the same layouts. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>require-tooling</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <fail>true</fail>
                            <rules>
                                <requireMavenVersion>
                                    <version>[3.6.3,)</version>
                                    <message>DirXMLDev needs Maven 3.9 or newer (3.6.3 is the oldest the build plugins accept). A distribution's stock Maven is often older: install a current Maven from maven.apache.org or your package manager's newer channel, and run it with JDK 21.</message>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                    <message>DirXMLDev builds with JDK 21: set JAVA_HOME to a JDK 21 (on macOS, JAVA_HOME=$(/usr/libexec/java_home -v 21)).</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                    <execution>
                        <id>require-engine</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <skip>${idm.skip.engine}</skip>
                            <fail>true</fail>
                            <rules>
                                <requireFilesExist>
                                    <message>DirXMLDev needs the proprietary NetIQ/OpenText jars as regular files in a real lib/ directory, and dirxml-simulator ${simulator.version} installed by 'mvn install' in the DirXMLSimulator repo. They are not committed and not on Maven Central. A directory symlink of lib/, or a symlink of a jar, is not enough: requireFilesExist reports that path as missing. Copy the jars; an engine from 4.10.2 on ships xp.jar as xp-1.0.0.jar — copy it as xp.jar. `mvn test` is the full suite and stops here when they are absent or linked. Doctor and the write gate still run without them: mvn -B -Pidm.portable test. See docs/install.md section 2 and bin/require-engine.sh.</message>
                                    <files>
                                        <file>${idm.lib}/dirxml.jar</file>
                                        <file>${idm.lib}/dirxml_misc.jar</file>
                                        <file>${idm.lib}/nxsl.jar</file>
                                        <file>${idm.lib}/xp.jar</file>
                                        <file>${idm.lib}/CommonDriverShim.jar</file>
                                        <file>${idm.lib}/jclient.jar</file>
                                        <file>${idm.lib}/dhutil.jar</file>
                                        <file>${idm.lib}/XDS.jar</file>
                                        <file>${idm.lib}/js.jar</file>
                                        <file>${idm.lib}/ldap.jar</file>
                                        <file>${user.home}/.m2/repository/com/pointblue/dirxml/dirxml-simulator/${simulator.version}/dirxml-simulator-${simulator.version}.jar</file>
                                    </files>
                                </requireFilesExist>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Active when lib/dirxml.jar exists. File.exists follows a symlink, so a linked
         lib/ still turns this profile on; requireFilesExist then rejects the link.
         Maven resolves project dependencies before the lifecycle, so these stay out of the main
         POM: without them, `mvn test` reaches the enforcer and stops with the file list.
         With real jar files, the suite compiles. The profile does not make the jars optional —
         the sources import the engine and the simulator. -->
    <profiles>
        <profile>
            <id>engine</id>
            <activation>
                <file>
                    <exists>lib/dirxml.jar</exists>
                </file>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>com.pointblue.dirxml</groupId>
                    <artifactId>dirxml-simulator</artifactId>
                    <version>${simulator.version}</version>
                </dependency>
                <!-- Proprietary NetIQ/OpenText jars. System scope does not propagate, so they are
                     declared here as well as living in lib/. lib/ is gitignored. -->
                <dependency><groupId>com.netiq.idm</groupId><artifactId>dirxml</artifactId><version>4.10.1.0000</version><scope>system</scope><systemPath>${idm.lib}/dirxml.jar</systemPath></dependency>
                <dependency><groupId>com.netiq.idm</groupId><artifactId>dirxml_misc</artifactId><version>4.10.1.0000</version><scope>system</scope><systemPath>${idm.lib}/dirxml_misc.jar</systemPath></dependency>
                <dependency><groupId>com.netiq.idm</groupId><artifactId>nxsl</artifactId><version>1.0.0</version><scope>system</scope><systemPath>${idm.lib}/nxsl.jar</systemPath></dependency>
                <dependency><groupId>com.netiq.idm</groupId><artifactId>xp</artifactId><version>1.0.0</version><scope>system</scope><systemPath>${idm.lib}/xp.jar</systemPath></dependency>
                <dependency><groupId>com.netiq.idm</groupId><artifactId>CommonDriverShim</artifactId><version>1.0.0</version><scope>system</scope><systemPath>${idm.lib}/CommonDriverShim.jar</systemPath></dependency>
                <dependency><groupId>com.netiq.idm</groupId><artifactId>jclient</artifactId><version>1.0.0</version><scope>system</scope><systemPath>${idm.lib}/jclient.jar</systemPath></dependency>
                <dependency><groupId>com.netiq.idm</groupId><artifactId>dhutil</artifactId><version>1.0.0</version><scope>system</scope><systemPath>${idm.lib}/dhutil.jar</systemPath></dependency>
                <dependency><groupId>com.netiq.idm</groupId><artifactId>XDS</artifactId><version>1.0.0</version><scope>system</scope><systemPath>${idm.lib}/XDS.jar</systemPath></dependency>
                <dependency><groupId>com.netiq.idm</groupId><artifactId>js</artifactId><version>1.0.0</version><scope>system</scope><systemPath>${idm.lib}/js.jar</systemPath></dependency>
                <dependency><groupId>com.novell.ldap</groupId><artifactId>jldap</artifactId><version>4.3</version><scope>system</scope><systemPath>${idm.lib}/ldap.jar</systemPath></dependency>
            </dependencies>
        </profile>
        <!-- Tests that compile without the engine or the simulator. GitHub Actions runs this
             on every push. It does not compile the rest of src/main. `mvn test` (no profile)
             remains the full suite and still fails the validate check when the jars are absent. -->
        <profile>
            <id>idm.portable</id>
            <properties>
                <idm.skip.engine>true</idm.skip.engine>
                <maven.main.skip>true</maven.main.skip>
                <maven.test.skip>true</maven.test.skip>
                <maven.resources.skip>true</maven.resources.skip>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>3.3.1</version>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.8.1</version>
                        <executions>
                            <execution>
                                <id>portable-junit</id>
                                <phase>generate-test-resources</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <includeScope>test</includeScope>
                                    <outputDirectory>${project.build.directory}/portable-lib</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>portable-tests</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>${project.basedir}/bin/ci-portable.sh</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
